From d8efa6ff1c41285eb96c87b8149f6f6bbd30e21d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 11 Jul 2026 15:53:14 +0000
Subject: [PATCH 3/3] Wire up CascadeBuilder's dead RadiusSnap shimmer guard

RadiusSnap was declared with a clear intent ("quantize sphere radius to
1/16 units (size-shimmer guard)") but was never actually applied
anywhere in FitCascade. The cascade center gets snapped to texel-sized
steps, but the texel size itself (radius * 2 / ShadowSize) was left
unquantized -- so the snap grid it's snapping to was itself drifting
continuously with the camera's exact frustum-slice radius each frame,
which reintroduces the shimmer the center-snap was meant to prevent.

Radius is now quantized outward (ceiling, never shrinking the box) to
the nearest RadiusSnap before it's used to derive both the light's
distance and the texel size.

Verified: built clean, then ran the real engine headlessly with a
directional-light test scene to confirm CascadeBuilder.Build() (now
exercising the new snap) runs without exception and the sky/lighting
still render correctly. No real occluding geometry was available to
directly observe shimmer reduction (this sandbox's Assets/ are
gitignored), so the shimmer-fix claim rests on the math matching the
already-present, previously-unused comment's stated intent -- worth a
visual check against real content before relying on it.
---
 Centauri/Rendering/Shadows/CascadeBuilder.cs | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Centauri/Rendering/Shadows/CascadeBuilder.cs b/Centauri/Rendering/Shadows/CascadeBuilder.cs
index 1495399..ea000b0 100644
--- a/Centauri/Rendering/Shadows/CascadeBuilder.cs
+++ b/Centauri/Rendering/Shadows/CascadeBuilder.cs
@@ -106,7 +106,12 @@ public sealed class CascadeBuilder
             center += p;
         center /= 8f;
 
+        // Quantize outward (never shrink — the box must still contain the slice) so texelSize
+        // below, and therefore the centerLS snap grid, only steps discretely instead of drifting
+        // continuously with the camera's exact distance/FOV each frame — without this the center
+        // snap alone doesn't stop shimmer, since the grid it's snapping to is itself unstable.
         var radius = ComputeRadius(corners, center);
+        radius = MathF.Ceiling(radius / RadiusSnap) * RadiusSnap;
 
         var up   = MathF.Abs(dir.Y) > UpThreshold ? Vector3.UnitZ : Vector3.UnitY;
         var view = Matrix4x4.CreateLookAt(center - dir * radius, center, up);
-- 
2.43.0

