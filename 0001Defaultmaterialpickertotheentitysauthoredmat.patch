From 038c6823040a7e13b0201ff4440f29a4ee92b1a4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 13 Jul 2026 19:39:57 +0000
Subject: [PATCH] Default material picker to the entity's authored material
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The combo previously always started at index 0 (materialIds[0]) until the
user picked something, even for entities that already had a material
assigned — misleading, since the picker looked unset for anything loaded
from a scene file. Add EntitySetLoader.GetMaterialId to expose the
tracked source's current material id, and resolve it to an index each
frame the material rows are drawn, replacing the per-slot material-name
label that served no other purpose.
---
 Centauri/Loading/EntitySets/EntitySetLoader.cs     |  7 +++++++
 .../Inspector/Sections/EntityInspectorSection.cs   | 14 +++++++++++++-
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/Centauri/Loading/EntitySets/EntitySetLoader.cs b/Centauri/Loading/EntitySets/EntitySetLoader.cs
index 4b0281d..3743c20 100644
--- a/Centauri/Loading/EntitySets/EntitySetLoader.cs
+++ b/Centauri/Loading/EntitySets/EntitySetLoader.cs
@@ -167,6 +167,13 @@ public class EntitySetLoader
         source.Materials = null;
     }
 
+    // The material id currently authored for this entity (kept in sync by SetMaterial above) —
+    // lets the inspector's material picker default to the entity's actual current selection
+    // instead of always starting at index 0. Null for untracked entities (e.g. the environment's
+    // own "sun") or ones with no single-id binding (multi-slot "materials", never set here).
+    public string? GetMaterialId(Entity entity) =>
+        _sources.TryGetValue(entity, out var source) ? source.Material : null;
+
     // Removes an entity the editor created/loaded — drops its save tracking too, so a deleted
     // entity doesn't reappear on the next Save() of whichever file it belonged to.
     public void DeleteEntity(Entity entity)
diff --git a/Centauri/UI/Panels/Inspector/Sections/EntityInspectorSection.cs b/Centauri/UI/Panels/Inspector/Sections/EntityInspectorSection.cs
index 9602e14..28398c0 100644
--- a/Centauri/UI/Panels/Inspector/Sections/EntityInspectorSection.cs
+++ b/Centauri/UI/Panels/Inspector/Sections/EntityInspectorSection.cs
@@ -100,7 +100,7 @@ public sealed class EntityInspectorSection : ISection
 
             ImGui.PushID(i);
 
-            ImGui.TextDisabled($"{mat.Name}");
+            SyncSelectedMaterial(e);
             Widgets.ColorRow4("Base Color", mat.Color, v => EditMaterial(e, scene, index, m => m.Color = v));
             Widgets.SliderRow("Roughness", mat.RoughnessScalar, v => EditMaterial(e, scene, index, m => m.RoughnessScalar = v), 0f, 1f, 0.5f);
             Widgets.SliderRow("Metallic",  mat.MetallicScalar,  v => EditMaterial(e, scene, index, m => m.MetallicScalar  = v), 0f, 1f, 0.1f);
@@ -130,6 +130,18 @@ public sealed class EntityInspectorSection : ISection
             _entitySetLoader.SetMaterial(e, materialIds[_selectedMaterial]);
     }
 
+    // Keeps _selectedMaterial pointed at whatever's actually authored on the entity, rather than
+    // whatever was last picked in a *different* entity's combo — otherwise switching selection
+    // shows index 0 (or the previous entity's index) until the user re-picks something.
+    private void SyncSelectedMaterial(Entity e)
+    {
+        var materialIds = _materialIds ??= _resourceSystem.MaterialIds.ToArray();
+        if (_entitySetLoader.GetMaterialId(e) is not { } materialId) return;
+
+        var idx = Array.IndexOf(materialIds, materialId);
+        if (idx >= 0) _selectedMaterial = idx;
+    }
+
     private static void DrawLight(Entity e)
     {
         using var s = Widgets.Section("Light");
