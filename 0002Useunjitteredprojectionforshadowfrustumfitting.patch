From 33943e4e33a3054f37f301fa3b673bfa05f18e74 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 12 Jul 2026 22:28:01 +0000
Subject: [PATCH 2/2] Use unjittered projection for shadow frustum fitting and
 cache gating
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

CascadeBuilder.GetFrustumCorners and ShadowMapper's camera-static check
both read Camera.GetProjectionMatrix(), which bakes in TAA's per-frame
sub-pixel jitter (JitterNdc). That jitter is a display-only technique
with no bearing on which world-space slice the shadow needs to cover,
but reading it here means the frustum corners — and the fitted
cascades derived from them — wobble every single frame purely from
jitter, even with a genuinely static camera and light. It also meant
the light-throttle's camera-static check could never be true with TAA
enabled (the default), since the jittered projection differs every
frame regardless of real camera movement.

Both now use GetProjectionMatrixRaw() instead. Verified with a
headless render (static camera, static light, wind disabled): redraws
drop from 120/120 to 1/120 across 120 frames, confirming the fitted
cascades are now stable against jitter alone. Note: in a scene with
animated foliage, this fix alone doesn't reduce redraw frequency —
wind-driven staleness is gated by the pre-existing, separate
WindThrottleMs mechanism, not by this.
---
 Centauri/Rendering/Shadows/CascadeBuilder.cs | 11 +++++++++--
 Centauri/Rendering/Shadows/ShadowMapper.cs   |  8 ++++++--
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/Centauri/Rendering/Shadows/CascadeBuilder.cs b/Centauri/Rendering/Shadows/CascadeBuilder.cs
index 10e99d7..1a488ab 100644
--- a/Centauri/Rendering/Shadows/CascadeBuilder.cs
+++ b/Centauri/Rendering/Shadows/CascadeBuilder.cs
@@ -79,10 +79,17 @@ public sealed class CascadeBuilder
         return cascades;
     }
 
-    // world-space corners of the camera's full frustum, unprojected from NDC
+    // world-space corners of the camera's full frustum, unprojected from NDC. Uses the RAW
+    // (unjittered) projection — TAA's per-frame sub-pixel jitter (see Camera.JitterNdc) is a
+    // display-only technique with no bearing on which world-space slice the shadow needs to
+    // cover, so using the jittered matrix here would wobble the fitted cascades every single
+    // frame purely from jitter, even with a genuinely static camera and light — exactly the kind
+    // of continuous, imperceptible-per-frame change the texel/Z snap and ShadowCache are meant to
+    // collapse, except jitter offers no such fixed grid to collapse onto since it's not a
+    // translation within one.
     private static void GetFrustumCorners(Camera camera, Span<Vector3> corners)
     {
-        Matrix4x4.Invert(camera.GetViewMatrix() * camera.GetProjectionMatrix(), out var invVP);
+        Matrix4x4.Invert(camera.GetViewMatrix() * camera.GetProjectionMatrixRaw(), out var invVP);
 
         var k = 0;
         for (var x = 0; x < 2; x++)
diff --git a/Centauri/Rendering/Shadows/ShadowMapper.cs b/Centauri/Rendering/Shadows/ShadowMapper.cs
index 2da37ca..80f1e58 100644
--- a/Centauri/Rendering/Shadows/ShadowMapper.cs
+++ b/Centauri/Rendering/Shadows/ShadowMapper.cs
@@ -130,8 +130,12 @@ public sealed class ShadowMapper : IDisposable
 
         // Camera view/proj this frame, compared against last frame's below — a moved camera must
         // never be allowed the stale-fit reuse path (CanReuseStaleFit), only the light throttle.
+        // Raw (unjittered) projection, same reasoning as GetFrustumCorners below: TAA's per-frame
+        // jitter would otherwise make this comparison fail every frame regardless of whether the
+        // camera actually moved, since it's baked into GetProjectionMatrix() but isn't a real
+        // camera change.
         var view = camera.GetViewMatrix();
-        var proj = camera.GetProjectionMatrix();
+        var proj = camera.GetProjectionMatrixRaw();
         var cameraStatic = _lastCameraView == view && _lastCameraProj == proj;
         _lastCameraView = view;
         _lastCameraProj = proj;
@@ -176,7 +180,7 @@ public sealed class ShadowMapper : IDisposable
 
         SetRenderState();
         _depth.Use();
-        
+
         _depth.SetUniform("uAlbedo", 0);
         _depth.SetUniform("uFoliageAlphaCutoff", _config.Foliage.AlphaCutoff);
         ShaderUniformBinder.UploadWind(_depth, _config.Foliage);
